# Copy this file to `.env` (and `packages/database/.env`) and adjust if needed.
# Connection string for PostgreSQL (>= 15).
# Defaults match docker/docker-compose.yml (`bun run db:up`).

DATABASE_URL="xxx"

OPENAI_API_KEY="your-openai-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-generative-ai-api-key"

# API base URL used by the CLI (also the OAuth redirect host)
API_URL="http://localhost:3000"

# Clerk (CLI login via OAuth)
CLERK_FRONTEND_API="https://your-instance.clerk.accounts.dev"
CLERK_OAUTH_CLIENT_ID="your-clerk-oauth-client-id"
CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Polar (credits billing)
POLAR_ACCESS_TOKEN="polar_oat_xxx"
POLAR_PRODUCT_ID="your-polar-product-id"
POLAR_CREDITS_METER_ID="your-polar-credits-meter-id"
# "sandbox" (default) or "production"
POLAR_SERVER="sandbox"
